@model SOQuestion.Models.LoginViewModel
@{
    ViewData["Title"] = "Home Page";
}

<form id="login" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="ErrorEmailRequired" type="hidden" />
    <input asp-for="ErrorInvalidEmail" type="hidden" />
    <input asp-for="ErrorPasswordRequired" type="hidden" />
    <input asp-for="LanguageId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mt-3">
        <label for="Email">Email</label>
        <input data-val-email="2" asp-for="Email" class="form-control" aria-required="true" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="mt-3">
        <label for="Password">Password</label>
        <input asp-for="Password" class="form-control" aria-required="true" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="mt-3">
        <a id="submitButton" class="btn btn-primary">Login</a>
    </div>
</form>
@section scripts {
    <script src="~/js/index.js"></script>  
}